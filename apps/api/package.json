{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "18.x"
  },
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "node_modules/.bin/prisma generate && ../../node_modules/.bin/tsc --project tsconfig.json",
    "start": "node dist/app.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node --max-old-space-size=4096 ../../node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/lib-storage": "^3.1064.0",
    "@aws-sdk/s3-request-presigner": "^3.758.0",
    "@prisma/client": "5.22.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.0.0",
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "prisma": "5.22.0",
    "resend": "^4.1.2",
    "stripe": "^17.7.0",
    "tsx": "^4.19.3",
    "typescript": "^5.3.3",
    "zod": "^3.24.2"
  },
  "prisma": {
    "seed": "node --max-old-space-size=4096 ../../node_modules/tsx/dist/cli.mjs prisma/seed.ts"
  }
}
